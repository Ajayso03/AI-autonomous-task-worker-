# =====================================================================
# CentrAlign AI — Autonomous AI Task Worker Configuration
# =====================================================================

# LLM Provider Selection: "deterministic" | "gemini" | "openai"
# Default is "deterministic", which runs a fully autonomous, offline-reproducible
# semantic ReAct engine without needing external API keys or network calls.
# Set to "gemini" or "openai" to use live frontier models.
LLM_PROVIDER=deterministic

# Live Model API Keys (Required only if LLM_PROVIDER is "gemini" or "openai")
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Safety & Autonomous Execution Guardrails
AGENT_MAX_STEPS=12
HIGH_VALUE_APPROVAL_THRESHOLD=5000.0
MAX_TOOL_RETRIES=3
STRICT_INDEPENDENT_VERIFICATION=true

# Sandbox Environment Storage
SANDBOX_DIR=./data/company_files
ERP_DB_PATH=./data/company_erp.db
